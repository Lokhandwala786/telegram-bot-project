TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: your numeric chat id — used as admin for /subscribers, /list, /stats, /broadcast
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Paid Subscribe — optional if using Stripe Payment Links in config.yaml (subscription.payment_mode: stripe_links).
# Only needed for Telegram in-app checkout (often shows "Checkout Test" with a TEST token):
# TELEGRAM_PAYMENT_PROVIDER_TOKEN=YOUR_LIVE_BOTFATHER_PROVIDER_TOKEN

# Stripe webhook (recommended with stripe_links): auto-activate + "Payment received" message after card pay.
# Stripe Dashboard → Developers → Webhooks → endpoint https://YOUR_DOMAIN/stripe/webhook
# Events: checkout.session.completed
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...   # Stripe Dashboard → API keys (verifies payment on bot return)
# STRIPE_WEBHOOK_HOST=127.0.0.1
# STRIPE_WEBHOOK_PORT=8765

# Polling interval (low latency). Example: 20 seconds.
POLL_INTERVAL_SECONDS=20

# Optional: periodic "still alive" Telegram to TELEGRAM_CHAT_ID (hours between messages). 0 = off (default).
# HEARTBEAT_INTERVAL_HOURS=24

# If true, runs without sending Telegram messages (prints instead)
DRY_RUN=false

# Shift watcher (`python -m app.shift_alert run`) also respects DRY_RUN:
# saves a screenshot under data/ and logs the caption without Telegram or state updates.

# Optional: default session files for shift_alert (CLI --storage-state / --state-path override these)
# SHIFT_ALERT_STORAGE_STATE=data/amazon_shift_session.json
# SHIFT_ALERT_STATE_PATH=data/shift_alert_state.json

# Optional: fixed seconds between shift_alert full poll cycles (like POLL_INTERVAL_SECONDS for app.main). Overrides YAML min/max.
# SHIFT_ALERT_POLL_SECONDS=1

# Optional: override config path (defaults to config.yaml in repo root)
CONFIG_PATH=config.yaml

# Optional: store SQLite DB somewhere else
# Use ONE absolute path so git pull / new folders never reset subscribers (data/jobs.db is gitignored).
# Example: SQLITE_PATH=C:/Users/You/project/data/jobs.db
SQLITE_PATH=data/jobs.db

# Optional HTTP tuning
HTTP_TIMEOUT_SECONDS=12
HTTP_CONCURRENCY=4

# Optional: user-estimated pay range shown when pay not listed (never treated as actual)
DEFAULT_EXPECTED_PAY_GBP_PER_HOUR_MIN=
DEFAULT_EXPECTED_PAY_GBP_PER_HOUR_MAX=
